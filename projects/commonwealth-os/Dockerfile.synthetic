FROM python:3.12-slim
WORKDIR /srv/commonwealth
COPY app/requirements.txt /srv/commonwealth/app/requirements.txt
RUN python -m pip install --no-cache-dir -r app/requirements.txt \
 && groupadd -r cw && useradd -r -g cw cw \
 && mkdir -p /data && chown -R cw:cw /data
COPY app/ /srv/commonwealth/app/
COPY workflow/ /srv/commonwealth/workflow/
USER cw
ENV CW_DB_PATH=/data/commonwealth-demo.sqlite3
EXPOSE 8000
CMD ["python","-m","uvicorn","app.main:app","--host","0.0.0.0","--port","8000"]

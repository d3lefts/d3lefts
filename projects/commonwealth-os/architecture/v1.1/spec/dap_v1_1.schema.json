{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commonwealth/dap-v1.1",
  "title": "Democratic Assurance Passport public evidence envelope v1.1 (schema-only)",
  "description": "Public evidence refs only; validation does NOT prove legal authority, election integrity, privacy, or human agency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jurisdiction_id",
    "tenant_id",
    "decision_id",
    "proposal_digest",
    "rule_digest",
    "election_proof_ref",
    "effect_scope_digest",
    "authority_epoch",
    "challenge_epoch",
    "rule_epoch",
    "claim_status",
    "claims",
    "public_evidence_root"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "jurisdiction_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rule_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "election_proof_ref": {
      "type": "string",
      "minLength": 1
    },
    "effect_scope_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "challenge_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "rule_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "claim_status": {
      "enum": [
        "DESIGN",
        "MODEL_TESTED",
        "EXTERNALLY_ASSESSED",
        "LEGALLY_AUTHORIZED",
        "DEPLOYED",
        "FAILED",
        "SUPERSEDED"
      ]
    },
    "public_evidence_root": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "predicate",
        "scope",
        "assumptions",
        "evidence_ref",
        "checker_version",
        "result",
        "expiry",
        "dependencies",
        "reviewer",
        "limitations"
      ],
      "properties": {
        "type": {
          "enum": [
            "HUMAN_AGENCY_EMPIRICAL",
            "POLITICAL_EQUALITY_EMPIRICAL",
            "ELECTION_PROTOCOL_CHECK",
            "LEGAL_HUMAN_ATTESTATION",
            "EFFECT_GUARD_CHECK"
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "checker_version": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS_IN_SCOPE",
            "FAIL",
            "UNKNOWN",
            "NOT_CONDUCTED"
          ]
        },
        "expiry": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

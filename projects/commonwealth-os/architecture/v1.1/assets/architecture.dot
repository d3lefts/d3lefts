digraph G {
 graph [rankdir=TB,pad=0.25,bgcolor="transparent",nodesep=0.45,ranksep=0.65];
 node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,color="#8a91a1",fillcolor="#f2f5fa",fontcolor="#263247",penwidth=1.2];
 edge [color="#7485a1",arrowsize=0.7];
 sovereign [label="Human citizens / authorized representatives\nIndependent choice and legal authority",fillcolor="#e7f1ff"];
 client [label="Mobile / web user experience\nAccessible, AI-off path, private credentials"];
 process [label="Democratic process core\nProposals • deliberation • signed rules • elections"];
 assurance [label="Democratic Assurance Passport\nTally proof • legal attestations • changes • review"];
 effect [label="Trusted execution boundary\nScope • epochs • stays • atomic effect receipts",fillcolor="#e8f6ee"];
 sources [label="Official sources / legal custody",shape=ellipse,fillcolor="#fff5e4"];
 ai [label="Optional, isolated civic intelligence",shape=ellipse,fillcolor="#fff5e4"];
 sovereign -> client -> process -> assurance -> effect; sources -> process [style=dashed]; sources -> assurance [style=dashed]; ai -> client [style=dashed];
}

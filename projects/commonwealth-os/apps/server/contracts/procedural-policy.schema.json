{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonwealth.example.invalid/schemas/policy-v0.4",
  "title": "Fictional Procedural Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quorum",
    "yesNumerator",
    "yesDenominator",
    "strict"
  ],
  "properties": {
    "quorum": {
      "type": "integer",
      "minimum": 1
    },
    "yesNumerator": {
      "type": "integer",
      "minimum": 1
    },
    "yesDenominator": {
      "type": "integer",
      "minimum": 1
    },
    "strict": {
      "type": "boolean"
    },
    "approvalBasis": {
      "enum": [
        "DECISIVE",
        "CAST",
        "PRESENT",
        "ELIGIBLE"
      ]
    },
    "quorumFraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "strict",
        "basis"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "strict": {
          "type": "boolean"
        },
        "basis": {
          "const": "ELIGIBLE"
        }
      }
    }
  },
  "$comment": "Cross-field constraints numerator <= denominator are checked by runtime independent policy evaluator."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonwealth.example.invalid/schemas/portable-evidence-v0.4",
  "title": "Portable Synthetic Governance Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope",
    "payload",
    "signature",
    "signerTrust"
  ],
  "properties": {
    "envelope": {
      "const": "commonwealth.os.portable-evidence.v1"
    },
    "signerTrust": {
      "const": "UNVERIFIED_UNLESS_PINNED_EXTERNALLY"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "keyId",
        "publicKeyPem",
        "signature"
      ],
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicKeyPem": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "format",
        "institution",
        "item",
        "events",
        "authorityJournal",
        "members",
        "policies",
        "revisions",
        "attendance",
        "votes",
        "sources",
        "sourceDependencies",
        "projections",
        "publicationApprovals",
        "legalAuthority",
        "officialCertification"
      ],
      "properties": {
        "format": {
          "const": "commonwealth.os.demo-evidence.v2"
        },
        "officialCertification": {
          "const": false
        },
        "legalAuthority": {
          "const": "NOT_ASSESSED"
        },
        "institution": {
          "type": "object"
        },
        "item": {
          "type": "object"
        },
        "events": {
          "type": "array"
        },
        "authorityJournal": {
          "type": "array"
        },
        "members": {
          "type": "array"
        },
        "policies": {
          "type": "array"
        },
        "revisions": {
          "type": "array"
        },
        "attendance": {
          "type": "array"
        },
        "votes": {
          "type": "array"
        },
        "sources": {
          "type": "array"
        },
        "sourceDependencies": {
          "type": "array"
        },
        "projections": {
          "type": "array"
        },
        "publicationApprovals": {
          "type": "array"
        }
      }
    }
  }
}

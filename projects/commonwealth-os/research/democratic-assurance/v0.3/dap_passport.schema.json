{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nightfall:dap:0.2",
  "title": "NIGHTFALL Democratic Assurance Passport - public metadata v0.2",
  "description": "Research-only metadata. Valid JSON does not imply legal, electoral, security, or empirical validity. No individual ballot choices, identities or inferred preferences.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_status", "decision", "vote", "authority", "effect", "human_evidence", "equality_evidence", "provenance"],
  "properties": {
    "schema_version": {"const": "dap.v0.2"},
    "claim_status": {"enum": ["synthetic-demo", "provisional", "independently-reviewed"]},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["institution_id", "decision_id", "proposal_sha256", "rules_sha256", "voter_roll_epoch"],
      "properties": {
        "institution_id": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rules_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "voter_roll_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "vote": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "election_proof_ref", "verifier_id", "tally_proof_status", "eligibility_proof_status", "ballot_secrecy_review_status"],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "election_proof_ref": {"type": "string", "minLength": 1},
        "verifier_id": {"type": "string", "minLength": 1},
        "tally_proof_status": {"$ref": "#/$defs/status"},
        "eligibility_proof_status": {"$ref": "#/$defs/status"},
        "ballot_secrecy_review_status": {"$ref": "#/$defs/status"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["law_epoch", "evidence_epoch", "budget_epoch", "source_ref", "legal_attestation_ref", "appeal_status", "attestation_status"],
      "properties": {
        "law_epoch": {"type": "integer", "minimum": 0},
        "evidence_epoch": {"type": "integer", "minimum": 0},
        "budget_epoch": {"type": "integer", "minimum": 0},
        "source_ref": {"type": "string", "minLength": 1},
        "legal_attestation_ref": {"type": "string", "minLength": 1},
        "appeal_status": {"enum": ["unknown", "clear", "stayed", "revoked", "pending"]},
        "attestation_status": {"$ref": "#/$defs/status"}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["permitted_kinds", "currency", "ceiling_minor_units", "expires_at_utc", "guard_verifier_ref", "mediation_audit_status"],
      "properties": {
        "permitted_kinds": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "ceiling_minor_units": {"type": "integer", "minimum": 0},
        "expires_at_utc": {"type": "string", "format": "date-time"},
        "guard_verifier_ref": {"type": "string", "minLength": 1},
        "mediation_audit_status": {"$ref": "#/$defs/status"}
      }
    },
    "human_evidence": {"$ref": "#/$defs/study"},
    "equality_evidence": {"$ref": "#/$defs/study"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["issued_utc", "scope", "assumptions", "reviewers", "checker_refs"],
      "properties": {
        "issued_utc": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "checker_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "status": {"enum": ["unverified", "externally-attested", "independently-verified", "failed"]},
    "study": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "population", "protocol_ref", "limitations"],
      "properties": {
        "status": {"enum": ["not-conducted", "under-review", "study-complete", "insufficient-evidence"]},
        "population": {"type": "string"},
        "protocol_ref": {"type": "string"},
        "limitations": {"type": "string"}
      }
    }
  }
}

# Untrusted CDK interpreter image. The trusted policy/verifier is NOT inside this image.
# Digest of built image is recorded in the experiment receipt.
FROM python:3.11-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
RUN apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir 'aws-cdk-lib==2.260.0' 'constructs==10.5.0' 'jsii==1.137.0'
USER 65534:65534
WORKDIR /src

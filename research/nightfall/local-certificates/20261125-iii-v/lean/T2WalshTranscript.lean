import Mathlib.Algebra.Group.AddChar
import Mathlib.Data.Complex.Basic
import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# NIGHTFALL T2 — the original-label character transcript determines its span

This is the exact Fourier-to-legal-queries semantic bridge. The hidden
secret is a genuine additive character s:G->ℂ (uniform dual in finite
binary case). The only observations are evaluations at actual labels H.

Two secrets that give identical original-label answers must give
identical phase values on every label in the additive subgroup generated
by H. Consequently every Fourier polynomial supported on that span,
and every four-slot polynomial whose individual labels lie in it,
is determined by precisely the observed original-label transcript.

There is no independence assumption on labels H, no ability to query a
synthetic XOR label, no postulated Fourier projection, and no
Boolean-function oracle substituted for the physical additive source.
Uniform-source Parseval and the outside-span Fourier tail are separate
analytic obligations of the full T2-31 theorem.
-/

namespace Nightfall.StructuralInformation.T2WalshTranscript

open Finset

variable {G : Type*} [AddCommGroup G] [DecidableEq G]

/-- The exact original-label character answers, with no unqueried values. -/
noncomputable def originalTranscript
    (H : Finset G) (s : AddChar G ℂ) : (↑H → ℂ) :=
  fun a => s a.1

/-- Equality of actual answers on H propagates precisely to the
subgroup of additive frequencies generated by H. -/
theorem character_agree_on_generated_span
    (H : Finset G) (s t : AddChar G ℂ)
    (hagrees : ∀ a ∈ H, s a = t a)
    (z : G) (hz : z ∈ AddSubgroup.closure (H : Set G)) :
    s z = t z := by
  induction hz using AddSubgroup.closure_induction with
  | mem a ha =>
      exact hagrees a (by simpa using ha)
  | zero =>
      simp
  | add a b ha hb iha ihb =>
      simpa only [AddChar.map_add_eq_mul, iha, ihb]
  | neg a ha iha =>
      simpa only [AddChar.map_neg_eq_inv, iha]

/-- Identical legal query transcripts give identical generated-span
Walsh phases, not merely identical answer parity for each generator. -/
theorem character_agree_of_transcript
    (H : Finset G) (s t : AddChar G ℂ)
    (htrans : originalTranscript H s = originalTranscript H t)
    (z : G) (hz : z ∈ AddSubgroup.closure (H : Set G)) :
    s z = t z := by
  apply character_agree_on_generated_span H s t _ z hz
  intro a ha
  have h := congrFun htrans ⟨a, ha⟩
  exact h

/-- Actual complex Walsh polynomial on arbitrary finite frequency support. -/
noncomputable def walshPolynomial
    (F : Finset G) (c : G → ℂ) (s : AddChar G ℂ) : ℂ :=
  ∑ z ∈ F, c z * s z

/-- Every supported-in-span Walsh polynomial is a deterministic
function of the real original query transcript (including when
some generators are linearly dependent). -/
theorem walsh_polynomial_depends_only_on_original_labels
    (H F : Finset G) (c : G → ℂ)
    (hF : ∀ z ∈ F, z ∈ AddSubgroup.closure (H : Set G))
    (s t : AddChar G ℂ)
    (htrans : originalTranscript H s = originalTranscript H t) :
    walshPolynomial F c s = walshPolynomial F c t := by
  unfold walshPolynomial
  apply Finset.sum_congr rfl
  intro z hz
  rw [character_agree_of_transcript H s t htrans z (hF z hz)]

/-- The original four-oracle-label frequency before any grouping. -/
def fourFrequency (a b c d : G) : G := a + b + c + d

theorem four_frequency_in_generated_span
    (H : Finset G) (a b c d : G)
    (ha : a ∈ AddSubgroup.closure (H : Set G))
    (hb : b ∈ AddSubgroup.closure (H : Set G))
    (hc : c ∈ AddSubgroup.closure (H : Set G))
    (hd : d ∈ AddSubgroup.closure (H : Set G)) :
    fourFrequency a b c d ∈ AddSubgroup.closure (H : Set G) := by
  exact add_mem (add_mem (add_mem ha hb) hc) hd

/-- Actual four-slot complex Fourier polynomial, without reducing
the physical tuple labels to independent input bits. -/
noncomputable def fourSlotPolynomial
    (D : Finset G) (c : (G × G × G × G) → ℂ)
    (s : AddChar G ℂ) : ℂ :=
  ∑ t ∈ D.product (D.product (D.product D)),
    c t * s (fourFrequency t.1 t.2.1 t.2.2.1 t.2.2.2)

/-- Querying all legal original labels in R determines every
four-query-slot Fourier term whose actual labels belong to D⊆span(R),
even if D contains the uncharged identity (zero) sector. -/
theorem four_slot_polynomial_depends_only_on_original_queries
    (H D : Finset G) (c : (G × G × G × G) → ℂ)
    (hD : ∀ a ∈ D, a ∈ AddSubgroup.closure (H : Set G))
    (s t : AddChar G ℂ)
    (htrans : originalTranscript H s = originalTranscript H t) :
    fourSlotPolynomial D c s = fourSlotPolynomial D c t := by
  unfold fourSlotPolynomial
  apply Finset.sum_congr rfl
  intro v hv
  rcases v with ⟨a, b, c', d⟩
  obtain ⟨ha, hrest⟩ := Finset.mem_product.mp hv
  obtain ⟨hb, hrest2⟩ := Finset.mem_product.mp hrest
  obtain ⟨hc, hd⟩ := Finset.mem_product.mp hrest2
  have hz : fourFrequency a b c' d ∈ AddSubgroup.closure (H : Set G) :=
    four_frequency_in_generated_span H a b c' d
      (hD a ha) (hD b hb) (hD c' hc) (hD d hd)
  rw [character_agree_of_transcript H s t htrans
       (fourFrequency a b c' d) hz]

#print axioms Nightfall.StructuralInformation.T2WalshTranscript.character_agree_on_generated_span
#print axioms Nightfall.StructuralInformation.T2WalshTranscript.character_agree_of_transcript
#print axioms Nightfall.StructuralInformation.T2WalshTranscript.walsh_polynomial_depends_only_on_original_labels
#print axioms Nightfall.StructuralInformation.T2WalshTranscript.four_frequency_in_generated_span
#print axioms Nightfall.StructuralInformation.T2WalshTranscript.four_slot_polynomial_depends_only_on_original_queries

end Nightfall.StructuralInformation.T2WalshTranscript

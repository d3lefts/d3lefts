def response (row : Array Nat) (x : Nat) : Nat :=
  branch (square ((List.range 9).foldl
    (fun a j => a + scale (sign x j) (coeff (row[j+1]?.getD 0)))
    (coeff (row[0]?.getD 0))))

def next (x i : Nat) : Nat := 5*i+1+response (rows[i]?.getD #[]) x
def leafIndex (x : Nat) : Nat := next x (next x (next x (next x 0))) - 156
def decode (x : Nat) : Nat := leaves[(leafIndex x)]?.getD 512

set_option maxRecDepth 65536 in
set_option maxHeartbeats 0 in
theorem exact_packet : ∀ x : Fin 512, decode x.val = x.val := by decide

theorem actual_square_alphabet : ∀ a : F, branch (square a) < 5 := by decide

theorem two_sign_alphabet_count : 5^3 < (2^9 : Nat) := by decide


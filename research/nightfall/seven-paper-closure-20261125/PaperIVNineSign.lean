/-! Paper IV, Theorem 4.1: exact published nine-sign packet.
Source: uploaded pack_n9_d4.json; manuscript reports SHA256
47ee524dce8d99bc176388a1ec5db72040be40c81d003828ac2c50faf0bdd9be.
Rows are breadth-first indexed by the five actual F9 square values;
unreachable leaves have sentinel 512. Field arithmetic is modulo 3
in the basis 1,t with t²=-1. -/
namespace Nightfall.PaperIVNineSign
abbrev F := ZMod 3 × ZMod 3

def coeff (k : Nat) : F := ((k % 3 : Nat), (k / 3 : Nat))
def sign (x j : Nat) : ZMod 3 :=
  if x / 2^(8-j) % 2 = 0 then 1 else -1
def scale (s : ZMod 3) (a : F) : F := (s*a.1,s*a.2)
def square (a : F) : F := (a.1*a.1-a.2*a.2,2*a.1*a.2)
def branch (a : F) : Nat :=
  if a = (0,0) then 0 else if a = (2,0) then 1 else
  if a = (1,0) then 2 else if a = (0,2) then 3 else
  if a = (0,1) then 4 else 5


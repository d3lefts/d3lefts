import InfinitePiQ2OriginalHeatBath
import InfinitePiQ2InfluenceStability
import Mathlib

/-!
# Exact complement measurability of frozen finite-label sections

If a finite-label table coordinate is frozen at a prescribed label b, its
pullback is measurable with respect to the σ-algebra generated by every
ORIGINAL source coordinate except i. This is the required non-oracle
`StronglyMeasurable[sourceOtherSigma i]` input to the certified one-site
rank-one source condExp pull-out.

No independent σ-algebra property, artificial law, atom floor, finiteness
of the ambient coordinate index, or conditional-measurability hypothesis
is required. A base site point is supplied only to reconstruct a full
source word from a complementary section in a purely measurable proof.
-/

namespace Nightfall.InfinitePiQ2FrozenLabelSection

open MeasureTheory
open Nightfall.InfinitePiQ2InfluenceStability
open Nightfall.InfinitePiQ2OriginalLabelTransport
open Nightfall.InfinitePiQ2OriginalHeatBath

universe u v w
variable {ι : Type u} {X : ι → Type v}
variable [∀ i, MeasurableSpace (X i)]

/-- A full source word constructed from one chosen site value and an
arbitrary tuple on every other coordinate. -/
noncomputable def reconstructOther (i : ι) (a₀ : X i)
    (z : (j : sourceOtherIndices i) → X j) : (j : ι) → X j :=
  fun j => if h : j = i then h.symm ▸ a₀ else z ⟨j, h⟩

theorem reconstructOther_measurable (i : ι) (a₀ : X i) :
    Measurable (reconstructOther (X := X) i a₀) := by
  classical
  apply measurable_pi_iff.mpr
  intro j
  by_cases hj : j = i
  · subst j
    simpa [reconstructOther] using
      (measurable_const :
        Measurable (fun _ : (q : sourceOtherIndices i) → X q => a₀))
  · simpa [reconstructOther, hj] using
      (measurable_pi_apply (⟨j, hj⟩ : sourceOtherIndices i))

theorem reconstructOther_restrict (i : ι) (a₀ : X i)
    (x : (j : ι) → X j) :
    reconstructOther (X := X) i a₀ ((sourceOtherIndices i).restrict x) =
      Function.update x i a₀ := by
  classical
  funext j
  by_cases hj : j = i
  · subst j
    simp [reconstructOther]
  · simp [reconstructOther, hj, Function.update_of_ne hj]

/-- Any measurable function unchanged by refreshing coordinate i is
measurable with respect to all original coordinates except i.
The given a₀ is a formal witness for the disintegration-free section. -/
theorem source_other_measurable_of_update_invariant
    (i : ι) (a₀ : X i)
    (v : ((j : ι) → X j) → ℝ)
    (hv : Measurable v)
    (hinv : ∀ x (a : X i), v (Function.update x i a) = v x) :
    Measurable[sourceOtherSigma (X := X) i] v := by
  classical
  let r : ((j : ι) → X j) →
      ((j : sourceOtherIndices i) → X j) :=
    fun x => (sourceOtherIndices i).restrict x
  have hr : Measurable[sourceOtherSigma (X := X) i] r := by
    exact comap_measurable r
  have hm : Measurable (fun z => v (reconstructOther (X := X) i a₀ z)) :=
    hv.comp (reconstructOther_measurable (X := X) i a₀)
  have hcomp : Measurable[sourceOtherSigma (X := X) i]
      (fun x => v (reconstructOther (X := X) i a₀ (r x))) :=
    hm.comp hr
  have heq : (fun x => v (reconstructOther (X := X) i a₀ (r x))) = v := by
    funext x
    change v (reconstructOther (X := X) i a₀
      ((sourceOtherIndices i).restrict x)) = v x
    rw [reconstructOther_restrict (X := X) i a₀ x]
    exact hinv x a₀
  simpa only [heq] using hcomp

/-- Frozen label sections satisfy the required strong complement
measurability, derived solely from the ORIGINAL source label map and
its genuine constituent measurability. -/
theorem frozen_label_section_stronglyMeasurable_other
    {Y : ι → Type w} [∀ j, MeasurableSpace (Y j)]
    (φ : ∀ j, X j → Y j) (hφ : ∀ j, Measurable (φ j))
    (g : ((j : ι) → Y j) → ℝ) (hg : Measurable g)
    (i : ι) (a₀ : X i) (b : Y i) :
    StronglyMeasurable[sourceOtherSigma (X := X) i]
      (fun x : (j : ι) → X j =>
        g (Function.update (sourceLabelMap φ x) i b)) := by
  classical
  have hup : Measurable (fun y : (j : ι) → Y j =>
      Function.update y i b) := by
    fun_prop
  have hsection : Measurable
      (fun x : (j : ι) → X j =>
        g (Function.update (sourceLabelMap φ x) i b)) :=
    hg.comp (hup.comp (sourceLabelMap_measurable φ hφ))
  have hinv (x : (j : ι) → X j) (a : X i) :
      g (Function.update (sourceLabelMap φ (Function.update x i a)) i b) =
        g (Function.update (sourceLabelMap φ x) i b) := by
    rw [sourceLabelMap_update]
    simp
  exact (source_other_measurable_of_update_invariant
    (X := X) i a₀
    (fun x => g (Function.update (sourceLabelMap φ x) i b))
    hsection hinv).stronglyMeasurable

#print axioms Nightfall.InfinitePiQ2FrozenLabelSection.reconstructOther_measurable
#print axioms Nightfall.InfinitePiQ2FrozenLabelSection.reconstructOther_restrict
#print axioms Nightfall.InfinitePiQ2FrozenLabelSection.source_other_measurable_of_update_invariant
#print axioms Nightfall.InfinitePiQ2FrozenLabelSection.frozen_label_section_stronglyMeasurable_other

end Nightfall.InfinitePiQ2FrozenLabelSection

import InfinitePiQ2UnconditionalTerminal

/-!
# Hoeffding (Efron–Stein) degree two implies the triple-residual hypothesis

Under the original product law `ν = Measure.infinitePi μ`:

* `coordSigma S` is the sigma algebra of the coordinates in a finite set `S`;
* a **Hoeffding component on `S`** is an `L²(ν)` class measurable for
  `coordSigma S` and degenerate in each of its own coordinates:
  `E_ν[H | all coordinates ≠ i] = 0` for every `i ∈ S`;
* `G` has **Hoeffding degree ≤ 2** when it lies in the `L²` closure of the
  span of Hoeffding components on sets of size at most two (infinite
  Efron–Stein/ANOVA sums are allowed through the closure).

`hoeffdingDegreeLeTwo_tripleResidualZero` proves that every such `G`
satisfies `TripleResidualZero`, so the a.e. infinite-product C105.416
terminal applies to it (`infinitePi_q2_105416_hoeffding`).

Scope: the degeneracy used here is the per-coordinate form
`E[H | x_{-i}] = 0 (i ∈ S)`, which the textbook condition
`E[H | x_T] = 0 for all T ⊉ S` implies, so the hypothesis is no stronger than
the textbook one. Existence and uniqueness of the Hoeffding decomposition of
an arbitrary `L²` function on an infinite product are not formalized here.
-/

namespace Nightfall.InfinitePiQ2HoeffdingDegree

open MeasureTheory ProbabilityTheory
open Nightfall.InfinitePiQ2InfluenceStability
open Nightfall.InfinitePiQ2Density
open Nightfall.InfinitePiQ2CellAverage
open Nightfall.InfinitePiQ2UnconditionalTerminal

universe u v

variable {ι : Type u} [DecidableEq ι] {X : ι → Type v}
variable [∀ i, MeasurableSpace (X i)]

/-- The sigma algebra generated by the coordinates in `S`. -/
def coordSigma (S : Finset ι) : MeasurableSpace ((i : ι) → X i) :=
  MeasurableSpace.comap (fun x : (i : ι) → X i => fun j : S => x j)
    (inferInstance : MeasurableSpace ((j : S) → X j))

theorem coordSigma_le_other {S : Finset ι} {l : ι} (hl : l ∉ S) :
    coordSigma (X := X) S ≤ sourceOtherSigma (X := X) l := by
  refine Measurable.comap_le ?_
  refine @Measurable.of_eval _ _ _ (sourceOtherSigma (X := X) l) _ _ fun j => ?_
  have hj : (j : ι) ≠ l := fun h => hl (h ▸ j.2)
  exact measurable_coord_other hj

variable (μ : (i : ι) → Measure (X i)) [∀ i, IsProbabilityMeasure (μ i)]

/-- A Hoeffding (degenerate Efron–Stein) component on the coordinates `S`. -/
def HoeffdingComponent (S : Finset ι)
    (H : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)) : Prop :=
  AEStronglyMeasurable[coordSigma (X := X) S] (H : ((i : ι) → X i) → ℝ)
      (Measure.infinitePi μ) ∧
    ∀ i ∈ S, sourceOtherProjection μ i H = 0

/-- **Hoeffding degree ≤ 2**: `L²` limits of finite sums of Hoeffding
components on at most two coordinates. -/
def HoeffdingDegreeLeTwo (G : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)) : Prop :=
  G ∈ (Submodule.span ℝ {H | ∃ S : Finset ι, S.card ≤ 2 ∧
    HoeffdingComponent μ S H}).topologicalClosure

/-- The genuine residual at `i` as a continuous linear map. -/
noncomputable def residualCLM (i : ι) :
    Lp ℝ (2 : ENNReal) (Measure.infinitePi μ) →L[ℝ]
      Lp ℝ (2 : ENNReal) (Measure.infinitePi μ) :=
  ContinuousLinearMap.id ℝ _ -
    (lpMeas ℝ ℝ (sourceOtherSigma (X := X) i) 2 (Measure.infinitePi μ)).subtypeL.comp
      (condExpL2 ℝ ℝ (sourceOtherSigma_le (X := X) i))

theorem residualCLM_apply (i : ι) (G : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)) :
    residualCLM μ i G = sourceCoordinateResidual μ i G := rfl

/-- A class that ignores coordinate `l` has zero residual at `l`. -/
theorem residual_eq_zero_of_not_mem {S : Finset ι} {l : ι} (hl : l ∉ S)
    {H : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)}
    (hH : AEStronglyMeasurable[coordSigma (X := X) S] (H : ((i : ι) → X i) → ℝ)
      (Measure.infinitePi μ)) :
    sourceCoordinateResidual μ l H = 0 := by
  have hmem : H ∈ lpMeas ℝ ℝ (sourceOtherSigma (X := X) l) 2 (Measure.infinitePi μ) := by
    rw [mem_lpMeas_iff_aestronglyMeasurable]
    exact hH.mono (coordSigma_le_other hl)
  have hP : sourceOtherProjection μ l H = H := by
    unfold sourceOtherProjection
    have : Fact (sourceOtherSigma (X := X) l ≤ MeasurableSpace.pi) :=
      ⟨sourceOtherSigma_le (X := X) l⟩
    have h := Submodule.orthogonalProjectionOnto_mem_subspace_eq_self
      (K := lpMeas ℝ ℝ (sourceOtherSigma (X := X) l) 2 (Measure.infinitePi μ))
      ⟨H, hmem⟩
    exact congrArg Subtype.val h
  unfold sourceCoordinateResidual
  rw [hP, sub_self]

/-- A degenerate component is its own residual at each of its coordinates. -/
theorem residual_eq_self_of_mem {S : Finset ι} {l : ι} (hl : l ∈ S)
    {H : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)}
    (hH : HoeffdingComponent μ S H) :
    sourceCoordinateResidual μ l H = H := by
  unfold sourceCoordinateResidual
  rw [hH.2 l hl, sub_zero]

/-- **Bridge.** Hoeffding degree ≤ 2 implies the triple-residual hypothesis
of the a.e. infinite-product terminal. -/
theorem hoeffdingDegreeLeTwo_tripleResidualZero
    {G : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)} (hG : HoeffdingDegreeLeTwo μ G) :
    CellLabels.TripleResidualZero μ G := by
  intro i j k hij hik hjk
  set T := (residualCLM μ i).comp ((residualCLM μ j).comp (residualCLM μ k)) with hT
  have hTapp : ∀ H, T H = sourceCoordinateResidual μ i
      (sourceCoordinateResidual μ j (sourceCoordinateResidual μ k H)) := fun H => rfl
  have hgen : {H | ∃ S : Finset ι, S.card ≤ 2 ∧ HoeffdingComponent μ S H} ⊆
      (LinearMap.ker (T : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ) →ₗ[ℝ]
        Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)) : Set _) := by
    rintro H ⟨S, hS, hcomp⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker, ContinuousLinearMap.coe_coe, hTapp]
    by_cases hk : k ∈ S
    · rw [residual_eq_self_of_mem μ hk hcomp]
      by_cases hj : j ∈ S
      · rw [residual_eq_self_of_mem μ hj hcomp]
        have hi : i ∉ S := by
          intro hi
          have hsub : ({i, j, k} : Finset ι) ⊆ S := by
            intro x hx
            simp only [Finset.mem_insert, Finset.mem_singleton] at hx
            rcases hx with rfl | rfl | rfl <;> assumption
          have h3 : ({i, j, k} : Finset ι).card = 3 := by
            rw [Finset.card_insert_of_notMem (by simp [hij, hik]),
              Finset.card_pair hjk]
          have := Finset.card_le_card hsub
          omega
        exact residual_eq_zero_of_not_mem μ hi hcomp.1
      · rw [residual_eq_zero_of_not_mem μ hj hcomp.1]
        simp [sourceCoordinateResidual, sourceOtherProjection]
    · rw [residual_eq_zero_of_not_mem μ hk hcomp.1]
      simp [sourceCoordinateResidual, sourceOtherProjection]
  have hspan : Submodule.span ℝ {H | ∃ S : Finset ι, S.card ≤ 2 ∧ HoeffdingComponent μ S H} ≤
      LinearMap.ker (T : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ) →ₗ[ℝ]
        Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)) :=
    Submodule.span_le.mpr hgen
  have hclosed : IsClosed (LinearMap.ker (T : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ) →ₗ[ℝ]
      Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)) : Set (Lp ℝ (2 : ENNReal)
        (Measure.infinitePi μ))) := T.isClosed_ker
  have hmem := Submodule.topologicalClosure_minimal _ hspan hclosed hG
  rw [LinearMap.mem_ker, ContinuousLinearMap.coe_coe, hTapp] at hmem
  exact hmem

/-- **Unconditional infinite-product Q2, Hoeffding form.** Any index type in any
universe, any coordinate laws; `G ∈ L²(ν)` essentially bounded by `B`, of
Hoeffding degree ≤ 2, with every genuine original influence at most `M`. -/
theorem infinitePi_q2_105416_hoeffding
    (G : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ))
    (B : ℝ) (hB : 0 ≤ B) (hb : ∀ᵐ x ∂ Measure.infinitePi μ, |G x| ≤ B)
    (hdeg : HoeffdingDegreeLeTwo μ G)
    (M : ℝ) (hM : 0 ≤ M)
    (hI : ∀ i : ι, sourceCoordinateInfluence μ i G ≤ M) :
    (sourceL2Variance μ G) ^ 2 ≤
      ((2 * (1 + Real.sqrt 2)) * Real.sqrt 3 + 11901 / 6250) ^ 2 * B ^ 2 * M :=
  infinitePi_q2_105416_ae μ G B hB hb
    (hoeffdingDegreeLeTwo_tripleResidualZero μ hdeg) M hM hI

end Nightfall.InfinitePiQ2HoeffdingDegree

import InfinitePiQ2FiniteCellDensity
import Mathlib.MeasureTheory.Constructions.Cylinders

/-!
# Finite-cell algebra elements have an actual finite-coordinate support

Density of the Boolean algebra generated by one-coordinate measurable
rectangles is insufficient by itself for Q2 finite-model extraction.
This file identifies every event of that algebra with a genuine
measurable finite-coordinate cylinder under the unchanged product
measurable space, and provides its concrete finite support.

No countable source index assumption; no invented finite coordinate
oracle. Finite-cell sampling/disintegration still remains separate.
-/

namespace Nightfall.InfinitePiQ2FiniteCellSupport

open MeasureTheory
open Nightfall.InfinitePiQ2FiniteCellDensity

universe u v
variable {ι : Type u} {X : ι → Type v}
variable [∀ i, MeasurableSpace (X i)]

private theorem sourceSquareCylinder_measurableCylinder
    (s : Set ((i : ι) → X i))
    (hs : s ∈ squareCylinders
      (fun i => {t : Set (X i) | MeasurableSet t})) :
    s ∈ measurableCylinders X := by
  rcases hs with ⟨F, t, ht, rfl⟩
  let U : Set ((j : F) → X j) :=
    (Set.univ : Set F).pi (fun j : F => t j)
  have htmeas (j : F) : MeasurableSet (t j) := by
    have hj := ht (j : ι) (Set.mem_univ _)
    exact hj
  have hU : MeasurableSet U := by
    dsimp [U]
    apply MeasurableSet.pi Set.countable_univ
    intro j _
    exact htmeas j
  have heq : (↑F : Set ι).pi t = cylinder F U := by
    ext x
    change ((∀ i, i ∈ F → x i ∈ t i) ↔
      (F.restrict x ∈ U))
    constructor
    · intro hx
      change ∀ j : F, j ∈ (Set.univ : Set F) → (F.restrict x) j ∈ t j
      intro j _
      exact hx j j.property
    · intro hx i hi
      have hj : (F.restrict x) (⟨i, hi⟩ : F) ∈ t i :=
        hx ⟨i, hi⟩ (Set.mem_univ _)
      exact hj
  rw [heq]
  exact cylinder_mem_measurableCylinders F U hU

/-- Every finite Boolean algebra source-cell event is an actual
finite-coordinate measurable cylinder. This is stronger than L²
density: it extracts a concrete finite coordinate support. -/
theorem sourceFiniteCellAlgebra_subset_measurableCylinders :
    sourceFiniteCellAlgebra (X := X) ⊆ measurableCylinders X := by
  apply IsSetAlgebra.generateSetAlgebra_subset
  · intro s hs
    exact sourceSquareCylinder_measurableCylinder s hs
  · exact isSetAlgebra_measurableCylinders

/-- Each source-cell event has a finite coordinate set and a measurable
base set whose cylinder is *exactly* the original event. -/
theorem sourceFiniteCellAlgebra_exists_finite_support
    (s : Set ((i : ι) → X i))
    (hs : s ∈ sourceFiniteCellAlgebra (X := X)) :
    ∃ (F : Finset ι)
      (S : Set ((i : F) → X i)),
       MeasurableSet S ∧ s = cylinder F S := by
  exact (mem_measurableCylinders s).mp
    (sourceFiniteCellAlgebra_subset_measurableCylinders hs)

end Nightfall.InfinitePiQ2FiniteCellSupport

import InfinitePiQ2Density
import Mathlib.MeasureTheory.Constructions.Cylinders
import Mathlib.MeasureTheory.SetAlgebra

/-!
# Source-product finite-cell algebra L² density

Every finite Boolean combination of one-coordinate measurable rectangles
uses finitely many coordinates and finitely many membership predicates.
Its sigma algebra is the full (possibly uncountable-index) product sigma
algebra. This module proves the measure- and L²-density of precisely
that FINITE-CELL class under the original source Measure.infinitePi μ.

It does not claim that the *conditional average of a quadratic f* over
the finite cells is itself a pointwise quadratic finite table, or that
its genuine resampling influences contract. Those remain independent
obligations for the infinite-product C105.416 Q2 terminal.
-/

namespace Nightfall.InfinitePiQ2FiniteCellDensity

open MeasureTheory

universe u v
variable {ι : Type u} {X : ι → Type v}
variable [∀ i, MeasurableSpace (X i)]
variable (μ : (i : ι) → Measure (X i))
variable [∀ i, IsProbabilityMeasure (μ i)]

/-- Finite Boolean algebra generated by original-coordinate measurable
rectangles. Every event involves only finitely many coordinate tests. -/
def sourceFiniteCellAlgebra : Set (Set ((i : ι) → X i)) :=
  generateSetAlgebra
    (squareCylinders (fun i => {s : Set (X i) | MeasurableSet s}))

/-- The finite-cell algebra generates the TRUE product sigma algebra. -/
theorem sourceFiniteCellAlgebra_generates :
    MeasurableSpace.generateFrom (sourceFiniteCellAlgebra (X := X)) =
      (inferInstance : MeasurableSpace ((i : ι) → X i)) := by
  simp only [sourceFiniteCellAlgebra, generateFrom_generateSetAlgebra_eq,
    generateFrom_squareCylinders]

/-- Finite-cell events approximate every event in the actual original
product law in symmetric-difference measure, with no countability,
atomicity or finite-alphabet restrictions. -/
theorem sourceFiniteCellAlgebra_measure_dense :
    (Measure.infinitePi μ).MeasureDense (sourceFiniteCellAlgebra (X := X)) := by
  exact Measure.MeasureDense.of_generateFrom_isSetAlgebra_finite
    (μ := Measure.infinitePi μ)
    isSetAlgebra_generateSetAlgebra
    (sourceFiniteCellAlgebra_generates (X := X)).symm

noncomputable def sourceCellIndicator
    (s : Set ((i : ι) → X i))
    (hs : s ∈ sourceFiniteCellAlgebra (X := X))
    (c : ℝ) :
    Lp ℝ (2 : ENNReal) (Measure.infinitePi μ) :=
  indicatorConstLp 2
    ((sourceFiniteCellAlgebra_measure_dense μ).measurable s hs)
    (measure_ne_top (Measure.infinitePi μ) s) c

noncomputable def sourceCellGenerators :
    Set (Lp ℝ (2 : ENNReal) (Measure.infinitePi μ)) :=
  {v | ∃ (s : Set ((i : ι) → X i))
    (hs : s ∈ sourceFiniteCellAlgebra (X := X)) (c : ℝ),
      v = sourceCellIndicator μ s hs c}

/-- Stronger original-product density: finite linear combinations of
finite-Boolean-cell indicators are dense in L², not merely arbitrary
finite-coordinate measurable cylinders. -/
theorem sourceFiniteCellAlgebra_L2_dense :
    (Submodule.span ℝ (sourceCellGenerators μ)).topologicalClosure = ⊤ := by
  classical
  letI : Fact ((2 : ENNReal) ≠ ⊤) := ⟨by norm_num⟩
  let ν := Measure.infinitePi μ
  let S := sourceCellGenerators μ
  let U : Submodule ℝ (Lp ℝ (2 : ENNReal) ν) :=
    Submodule.span ℝ S
  let hA := sourceFiniteCellAlgebra_measure_dense μ
  have hAll : ∀ f : Lp ℝ (2 : ENNReal) ν,
      f ∈ U.topologicalClosure := by
    refine Lp.induction (μ := ν) (p := (2 : ENNReal))
      (by norm_num)
      (motive := fun f => f ∈ U.topologicalClosure) ?_ ?_
      U.isClosed_topologicalClosure
    · intro c s hs hνs
      rw [Lp.simpleFunc.coe_indicatorConst]
      have hmem :
          indicatorConstLp (2 : ENNReal) hs hνs.ne c ∈
          closure {indicatorConstLp (2 : ENNReal)
            (hA.measurable t ht) hνt c |
            (t : Set ((i : ι) → X i))
            (ht : t ∈ sourceFiniteCellAlgebra (X := X))
            (hνt : ν t ≠ ⊤)} :=
        (hA.indicatorConstLp_subset_closure (p := (2 : ENNReal)) c)
          ⟨s, hs, hνs.ne, rfl⟩
      have hsub :
          {indicatorConstLp (2 : ENNReal)
            (hA.measurable t ht) hνt c |
            (t : Set ((i : ι) → X i))
            (ht : t ∈ sourceFiniteCellAlgebra (X := X))
            (hνt : ν t ≠ ⊤)} ⊆ S := by
        rintro _ ⟨t, ht, hνt, rfl⟩
        exact ⟨t, ht, c, rfl⟩
      have hc := closure_mono hsub hmem
      exact (Submodule.closure_subset_topologicalClosure_span (R := ℝ) S) hc
    · intro f g hf hg hfg hUf hUg
      exact U.topologicalClosure.add_mem hUf hUg
  apply top_unique
  intro f hf
  exact hAll f

/-- Epsilon interface for finite-cell simple approximants under the
genuine infinite product law. -/
theorem sourceFiniteCellAlgebra_L2_approx
    (f : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ))
    (ε : ℝ) (hε : 0 < ε) :
    ∃ g : Lp ℝ (2 : ENNReal) (Measure.infinitePi μ),
      g ∈ Submodule.span ℝ (sourceCellGenerators μ) ∧
      ‖f - g‖ < ε := by
  have hmem :
      f ∈ (Submodule.span ℝ (sourceCellGenerators μ)).topologicalClosure := by
    rw [sourceFiniteCellAlgebra_L2_dense μ]
    trivial
  rw [← SetLike.mem_coe, Submodule.topologicalClosure_coe,
    Metric.mem_closure_iff] at hmem
  obtain ⟨g, hg, hnear⟩ := hmem ε hε
  exact ⟨g, hg, by simpa only [dist_eq_norm] using hnear⟩

end Nightfall.InfinitePiQ2FiniteCellDensity

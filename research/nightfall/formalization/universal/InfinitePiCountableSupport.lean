import Mathlib.MeasureTheory.Constructions.Cylinders
import Mathlib.MeasureTheory.Function.SimpleFuncDenseLp
import Mathlib.Probability.ProductMeasure

/-!
# Countable-coordinate source reduction on arbitrary product sigma algebras

This is a purely measure-theoretic structural bridge: even with an
uncountable index set and dependent coordinate types, every measurable
event is determined by at most countably many coordinates.

The underlying theorem is an existing Mathlib result, reproduced as a
named, pinned source-level compatibility target. This is NOT yet L2
finite-cylinder density or an all-L2 Efron–Stein theorem.

We further seek a derived measurable-REAL-observable countable support
as a separate declaration (the event-level result compiles independently).
-/

namespace Nightfall.InfinitePiCountableSupport

open MeasureTheory

universe u v
variable {ι : Type u} {X : ι → Type v}
variable [∀ i, MeasurableSpace (X i)]

/-- Exact product sigma-algebra is generated by its measurable finite
cylinders. No countability assumption on the index type. -/
theorem source_cylinders_generate_product :
    MeasurableSpace.generateFrom (measurableCylinders X) =
      MeasurableSpace.pi := by
  exact generateFrom_measurableCylinders

/-- Every product-measurable EVENT depends only on a countable set
of coordinates, even when the original index set is uncountable.
This theorem imports the existing Mathlib result without hiding
any supplementary measurability, separability or atom assumptions. -/
theorem source_measurable_event_countable_support
    (S : Set ((i : ι) → X i))
    (hS : MeasurableSet S) :
    ∃ (J : Set ι) (T : Set ((j : J) → X j)),
      J.Countable ∧ S = J.restrict ⁻¹' T := by
  exact MeasureTheory.MeasurableSet.eq_preimage_restrict_countable hS

end Nightfall.InfinitePiCountableSupport

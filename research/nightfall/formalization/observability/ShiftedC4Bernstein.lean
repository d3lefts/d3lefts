import Mathlib

/-!
# Exact scalar c/4 Bernstein semialgebraic certificate
Nine rational rectangles; each polynomial is a positive tensor
Bernstein expansion of bi-degree (4,4). No probabilistic hypotheses.
All coefficients verified with independent exact Fraction replay.
-/

namespace Nightfall.ShiftedC4Bernstein

private def F (x v : ℝ) : ℝ :=
  3 - (1-v)^2*(3-2*x^4+16*x*v*(1-x^2)+16*v^2*(1-x^2))

private theorem affine_unit (z a b : ℝ)
    (hab : a < b) (hza : a ≤ z) (hzb : z ≤ b) :
    0 ≤ (z-a)/(b-a) ∧ (z-a)/(b-a) ≤ 1 := by
  have hd : 0 < b-a := by linarith
  constructor
  · exact div_nonneg (sub_nonneg.mpr hza) (le_of_lt hd)
  · exact (div_le_iff₀ hd).mpr (by linarith)



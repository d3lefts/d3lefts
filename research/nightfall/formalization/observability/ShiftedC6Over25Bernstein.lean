exact nonnegative rational tensor Bernstein coefficients.
The numerical value 6/25 improves the separately certified 1/4 ratio.
This file is purely real algebra, NOT an original-source Q2 theorem.
-/

namespace Nightfall.ShiftedC6Over25Bernstein

private def F (x v : ℝ) : ℝ :=
  3-(1-v)^2*(3-2*x^4+(50/3:ℝ)*x*v*(1-x^2)+(625/36:ℝ)*v^2*(1-x^2))

private theorem affine_unit (z a b : ℝ)
    (hab : a < b) (hza : a ≤ z) (hzb : z ≤ b) :
    0 ≤ (z-a)/(b-a) ∧ (z-a)/(b-a) ≤ 1 := by
  have hd : 0 < b-a := by linarith
  constructor
  · exact div_nonneg (sub_nonneg.mpr hza) (le_of_lt hd)
  · exact (div_le_iff₀ hd).mpr (by linarith)


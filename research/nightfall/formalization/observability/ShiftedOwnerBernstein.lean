import Mathlib

/-! # Exact nonnegative Bernstein certificate for shifted-owner c/4
Generated from the 15-node / eight-leaf exact rational certificate.
Every box is a polynomial identity checked by ring and nonnegative
Bernstein basis terms checked by positivity. No sorry/admit/axiom.
This certifies only the scalar polynomial on [0,1]^2, NOT the
full Hilbert shifted fourth moment or original-source Q2 terminal. -/

namespace Nightfall.Observability.ShiftedOwnerBernstein

private def shiftedPoly (x t : ℝ) : ℝ :=
  3 - (1-t)^2*(3-2*x^4+16*t*x*(1-x^2)+16*t^2*(1-x^2))

private theorem box_1 (x t : ℝ)
    (hxlo : 0 ≤ x-(0:ℝ)) (hxhi : 0 ≤ (1/4:ℝ)-x)
    (htlo : 0 ≤ t-(0:ℝ)) (hthi : 0 ≤ (1/2:ℝ)-t) :
    0 ≤ shiftedPoly x t := by
  have hidentity : shiftedPoly x t =
      (12288:ℝ)*((1/4:ℝ)-x)^4*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (17408:ℝ)*((1/4:ℝ)-x)^4*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (14336:ℝ)*((1/4:ℝ)-x)^4*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (5120:ℝ)*((1/4:ℝ)-x)^4*(t-(0:ℝ))^4
      + (40960:ℝ)*(x-(0:ℝ))^1*((1/4:ℝ)-x)^3*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (53248:ℝ)*(x-(0:ℝ))^1*((1/4:ℝ)-x)^3*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (47104:ℝ)*(x-(0:ℝ))^1*((1/4:ℝ)-x)^3*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (18432:ℝ)*(x-(0:ℝ))^1*((1/4:ℝ)-x)^3*(t-(0:ℝ))^4
      + (49152:ℝ)*(x-(0:ℝ))^2*((1/4:ℝ)-x)^2*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (56320:ℝ)*(x-(0:ℝ))^2*((1/4:ℝ)-x)^2*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (56320:ℝ)*(x-(0:ℝ))^2*((1/4:ℝ)-x)^2*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (24832:ℝ)*(x-(0:ℝ))^2*((1/4:ℝ)-x)^2*(t-(0:ℝ))^4
      + (25088:ℝ)*(x-(0:ℝ))^3*((1/4:ℝ)-x)^1*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (23552:ℝ)*(x-(0:ℝ))^3*((1/4:ℝ)-x)^1*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (29312:ℝ)*(x-(0:ℝ))^3*((1/4:ℝ)-x)^1*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (14976:ℝ)*(x-(0:ℝ))^3*((1/4:ℝ)-x)^1*(t-(0:ℝ))^4
      + (32:ℝ)*(x-(0:ℝ))^4*((1/2:ℝ)-t)^4
      + (4704:ℝ)*(x-(0:ℝ))^4*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (3176:ℝ)*(x-(0:ℝ))^4*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (5808:ℝ)*(x-(0:ℝ))^4*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (3464:ℝ)*(x-(0:ℝ))^4*(t-(0:ℝ))^4 := by
    unfold shiftedPoly
    ring
  rw [hidentity]
  positivity


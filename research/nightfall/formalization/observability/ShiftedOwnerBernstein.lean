      + (8704:ℝ)*(x-(1/2:ℝ))^3*((1:ℝ)-x)^1*(t-(1/2:ℝ))^1*((1:ℝ)-t)^3
      + (15872:ℝ)*(x-(1/2:ℝ))^3*((1:ℝ)-x)^1*(t-(1/2:ℝ))^2*((1:ℝ)-t)^2
      + (12288:ℝ)*(x-(1/2:ℝ))^3*((1:ℝ)-x)^1*(t-(1/2:ℝ))^3*((1:ℝ)-t)^1
      + (3072:ℝ)*(x-(1/2:ℝ))^3*((1:ℝ)-x)^1*(t-(1/2:ℝ))^4
      + (704:ℝ)*(x-(1/2:ℝ))^4*((1:ℝ)-t)^4
      + (2944:ℝ)*(x-(1/2:ℝ))^4*(t-(1/2:ℝ))^1*((1:ℝ)-t)^3
      + (4544:ℝ)*(x-(1/2:ℝ))^4*(t-(1/2:ℝ))^2*((1:ℝ)-t)^2
      + (3072:ℝ)*(x-(1/2:ℝ))^4*(t-(1/2:ℝ))^3*((1:ℝ)-t)^1
      + (768:ℝ)*(x-(1/2:ℝ))^4*(t-(1/2:ℝ))^4 := by
    unfold shiftedPoly
    ring
  rw [hidentity]
  positivity

private theorem box_8 (x t : ℝ)
    (hxlo : 0 ≤ x-(3/4:ℝ)) (hxhi : 0 ≤ (1:ℝ)-x)
    (htlo : 0 ≤ t-(0:ℝ)) (hthi : 0 ≤ (1/2:ℝ)-t) :
    0 ≤ shiftedPoly x t := by
  have hidentity : shiftedPoly x t =
      (2592:ℝ)*((1:ℝ)-x)^4*((1/2:ℝ)-t)^4
      + (9312:ℝ)*((1:ℝ)-x)^4*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (13544:ℝ)*((1:ℝ)-x)^4*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (14000:ℝ)*((1:ℝ)-x)^4*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (5384:ℝ)*((1:ℝ)-x)^4*(t-(0:ℝ))^4
      + (13824:ℝ)*(x-(3/4:ℝ))^1*((1:ℝ)-x)^3*((1/2:ℝ)-t)^4
      + (53248:ℝ)*(x-(3/4:ℝ))^1*((1:ℝ)-x)^3*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (82816:ℝ)*(x-(3/4:ℝ))^1*((1:ℝ)-x)^3*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (74368:ℝ)*(x-(3/4:ℝ))^1*((1:ℝ)-x)^3*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (25344:ℝ)*(x-(3/4:ℝ))^1*((1:ℝ)-x)^3*(t-(0:ℝ))^4
      + (27648:ℝ)*(x-(3/4:ℝ))^2*((1:ℝ)-x)^2*((1/2:ℝ)-t)^4
      + (113664:ℝ)*(x-(3/4:ℝ))^2*((1:ℝ)-x)^2*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (183040:ℝ)*(x-(3/4:ℝ))^2*((1:ℝ)-x)^2*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (148480:ℝ)*(x-(3/4:ℝ))^2*((1:ℝ)-x)^2*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (45568:ℝ)*(x-(3/4:ℝ))^2*((1:ℝ)-x)^2*(t-(0:ℝ))^4
      + (24576:ℝ)*(x-(3/4:ℝ))^3*((1:ℝ)-x)^1*((1/2:ℝ)-t)^4
      + (106496:ℝ)*(x-(3/4:ℝ))^3*((1:ℝ)-x)^1*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (174080:ℝ)*(x-(3/4:ℝ))^3*((1:ℝ)-x)^1*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (131072:ℝ)*(x-(3/4:ℝ))^3*((1:ℝ)-x)^1*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (36864:ℝ)*(x-(3/4:ℝ))^3*((1:ℝ)-x)^1*(t-(0:ℝ))^4
      + (8192:ℝ)*(x-(3/4:ℝ))^4*((1/2:ℝ)-t)^4
      + (36864:ℝ)*(x-(3/4:ℝ))^4*(t-(0:ℝ))^1*((1/2:ℝ)-t)^3
      + (60416:ℝ)*(x-(3/4:ℝ))^4*(t-(0:ℝ))^2*((1/2:ℝ)-t)^2
      + (43008:ℝ)*(x-(3/4:ℝ))^4*(t-(0:ℝ))^3*((1/2:ℝ)-t)^1
      + (11264:ℝ)*(x-(3/4:ℝ))^4*(t-(0:ℝ))^4 := by
    unfold shiftedPoly
    ring
  rw [hidentity]
  positivity

theorem shifted_poly_nonnegative
    (x t : ℝ) (hx0 : 0 ≤ x) (hx1 : x ≤ 1)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    0 ≤ shiftedPoly x t := by
  by_cases hx14 : x ≤ (1/4:ℝ)
  · by_cases ht12 : t ≤ (1/2:ℝ)
    · exact box_1 x t (by linarith) (by linarith) (by linarith) (by linarith)
    · exact box_2 x t (by linarith) (by linarith) (by linarith) (by linarith)
  · by_cases hx12 : x ≤ (1/2:ℝ)
    · by_cases ht14 : t ≤ (1/4:ℝ)
      · exact box_3 x t (by linarith) (by linarith) (by linarith) (by linarith)
      · by_cases ht12 : t ≤ (1/2:ℝ)
        · exact box_4 x t (by linarith) (by linarith) (by linarith) (by linarith)
        · exact box_2 x t (by linarith) (by linarith) (by linarith) (by linarith)
    · by_cases hx34 : x ≤ (3/4:ℝ)
      · by_cases ht14 : t ≤ (1/4:ℝ)
        · exact box_5 x t (by linarith) (by linarith) (by linarith) (by linarith)
        · by_cases ht12 : t ≤ (1/2:ℝ)
          · exact box_6 x t (by linarith) (by linarith) (by linarith) (by linarith)
          · exact box_7 x t (by linarith) (by linarith) (by linarith) (by linarith)
      · by_cases ht12 : t ≤ (1/2:ℝ)
        · exact box_8 x t (by linarith) (by linarith) (by linarith) (by linarith)
        · exact box_7 x t (by linarith) (by linarith) (by linarith) (by linarith)

/-- Exact c/4 normalized fourth-moment interpolation polynomial. -/
theorem shifted_quarter_polynomial
    (x d : ℝ)
    (hx0 : 0 ≤ x) (hx1 : x ≤ 1)
    (hd0 : 0 ≤ d) (hd4 : d ≤ 4) :
    (1-d/4)^2 *
      (3-2*x^4+4*x*(1-x^2)*d+(1-x^2)*d^2) ≤ 3 := by
  have ht0 : 0 ≤ d/4 := by linarith
  have ht1 : d/4 ≤ 1 := by linarith
  have hp := shifted_poly_nonnegative x (d/4) hx0 hx1 ht0 ht1
  have heq :
    shiftedPoly x (d/4) =
      3-(1-d/4)^2 *
        (3-2*x^4+4*x*(1-x^2)*d+(1-x^2)*d^2) := by
      unfold shiftedPoly
      ring
  rw [heq] at hp
  linarith

end Nightfall.Observability.ShiftedOwnerBernstein

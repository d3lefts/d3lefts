import Mathlib

/-!
# Quantum-query hybrid telescope: metric semantics

A circuit is represented by a sequence of gates and oracle maps acting on
a metric state space. For any family of distance-preserving gates and reference
oracles, the exact state deviation of two oracle circuits is bounded by the
sum of the one-query oracle discrepancies evaluated at the *reference*
trajectory.

This is a genuine circuit-state induction, not a scalar union-bound
substitution. It does not assume the final hybrid inequality as a hypothesis.
The remaining semantic obligations are the finite coherent value-oracle
per-query discrepancy bound and the final measurement Lipschitz estimate.

No assertion is made here about the external BDST simulator, the encoding
query count, or the final strong product/mixture theorem.
-/

namespace Nightfall.QuantumHybridTelescope

variable {V : Type*} [PseudoMetricSpace V]

/-- Actual sequential state evolution for interleaved oracle and fixed gates. -/
def evolve (gate oracle : ℕ → V → V) (initial : V) : ℕ → V
  | 0 => initial
  | n + 1 => gate n (oracle n (evolve gate oracle initial n))

@[simp] theorem evolve_zero (gate oracle : ℕ → V → V) (initial : V) :
    evolve gate oracle initial 0 = initial := rfl

@[simp] theorem evolve_succ (gate oracle : ℕ → V → V)
    (initial : V) (n : ℕ) :
    evolve gate oracle initial (n + 1) =
      gate n (oracle n (evolve gate oracle initial n)) := rfl

/-- One quantum-oracle substitution changes the output by at most
its discrepancy on the reference state plus the pre-existing deviation.
The gate and the comparison oracle preserve distance *exactly*. -/
theorem hybrid_step
    (gate oracleX oracleY : ℕ → V → V) (initial : V)
    (hgate : ∀ n a b,
      dist (gate n a) (gate n b) = dist a b)
    (hOracleY : ∀ n a b,
      dist (oracleY n a) (oracleY n b) = dist a b)
    (n : ℕ) :
    dist (evolve gate oracleX initial (n + 1))
      (evolve gate oracleY initial (n + 1))
      ≤
    dist (evolve gate oracleX initial n)
      (evolve gate oracleY initial n) +
    dist (oracleX n (evolve gate oracleX initial n))
      (oracleY n (evolve gate oracleX initial n)) := by
  let x := evolve gate oracleX initial n
  let y := evolve gate oracleY initial n
  have htri :
      dist (oracleX n x) (oracleY n y)
      ≤ dist (oracleX n x) (oracleY n x) +
          dist (oracleY n x) (oracleY n y) :=
    dist_triangle _ _ _
  have hiso : dist (oracleY n x) (oracleY n y) = dist x y :=
    hOracleY n x y
  have hg : dist (gate n (oracleX n x))
      (gate n (oracleY n y)) =
        dist (oracleX n x) (oracleY n y) :=
    hgate n _ _
  change dist (gate n (oracleX n x)) (gate n (oracleY n y))
    ≤ dist x y + dist (oracleX n x) (oracleY n x)
  rw [hg, hiso] at *
  linarith

/-- Source-level hybrid telescope: no supplied error-accumulation axiom.
The reference pre-query states are exactly those generated by oracleX. -/
theorem hybrid_telescope
    (gate oracleX oracleY : ℕ → V → V) (initial : V)
    (hgate : ∀ n a b,
      dist (gate n a) (gate n b) = dist a b)
    (hOracleY : ∀ n a b,
      dist (oracleY n a) (oracleY n b) = dist a b)
    (t : ℕ) :
    dist (evolve gate oracleX initial t)
      (evolve gate oracleY initial t)
      ≤
    ∑ n ∈ Finset.range t,
      dist (oracleX n (evolve gate oracleX initial n))
        (oracleY n (evolve gate oracleX initial n)) := by
  induction t with
  | zero =>
      simp
  | succ n ih =>
      calc
        dist (evolve gate oracleX initial (n + 1))
            (evolve gate oracleY initial (n + 1))
          ≤ dist (evolve gate oracleX initial n)
              (evolve gate oracleY initial n) +
            dist (oracleX n (evolve gate oracleX initial n))
              (oracleY n (evolve gate oracleX initial n)) :=
                hybrid_step gate oracleX oracleY initial hgate hOracleY n
        _ ≤ (∑ j ∈ Finset.range n,
              dist (oracleX j (evolve gate oracleX initial j))
                (oracleY j (evolve gate oracleX initial j))) +
            dist (oracleX n (evolve gate oracleX initial n))
              (oracleY n (evolve gate oracleX initial n)) :=
                add_le_add_right ih _
        _ = ∑ j ∈ Finset.range (n + 1),
              dist (oracleX j (evolve gate oracleX initial j))
                (oracleY j (evolve gate oracleX initial j)) := by
                rw [Finset.sum_range_succ]

/-- H2 without postulating a global hybrid bound:
an explicit per-query square-root discrepancy and a 2-Lipschitz
measurement readout imply the 4-times-sum hybrid inequality.

The oracle-local sqrt estimate and measurement Lipschitz premise remain
explicit. Proving them for the coherent block oracle is the next
independent kernel subobligation. -/
theorem hybrid_readout
    (gate oracleX oracleY : ℕ → V → V) (initial : V)
    (readout : V → ℝ) (queryDiscrepancy : ℕ → ℝ)
    (hgate : ∀ n a b,
      dist (gate n a) (gate n b) = dist a b)
    (hOracleY : ∀ n a b,
      dist (oracleY n a) (oracleY n b) = dist a b)
    (hreadout : ∀ a b,
      |readout a - readout b| ≤ 2 * dist a b)
    (horacle : ∀ n,
      dist (oracleX n (evolve gate oracleX initial n))
        (oracleY n (evolve gate oracleX initial n))
        ≤ 2 * Real.sqrt (queryDiscrepancy n))
    (t : ℕ) :
    |readout (evolve gate oracleX initial t) -
      readout (evolve gate oracleY initial t)|
      ≤ 4 * ∑ n ∈ Finset.range t, Real.sqrt (queryDiscrepancy n) := by
  calc
    |readout (evolve gate oracleX initial t) -
      readout (evolve gate oracleY initial t)|
      ≤ 2 * dist (evolve gate oracleX initial t)
            (evolve gate oracleY initial t) :=
              hreadout _ _
    _ ≤ 2 * (∑ n ∈ Finset.range t,
          dist (oracleX n (evolve gate oracleX initial n))
            (oracleY n (evolve gate oracleX initial n))) :=
              mul_le_mul_of_nonneg_left
                (hybrid_telescope gate oracleX oracleY initial
                  hgate hOracleY t) (by norm_num)
    _ ≤ 2 * (∑ n ∈ Finset.range t,
          2 * Real.sqrt (queryDiscrepancy n)) := by
            apply mul_le_mul_of_nonneg_left _ (by norm_num)
            exact Finset.sum_le_sum (fun n _ => horacle n)
    _ = 4 * ∑ n ∈ Finset.range t,
          Real.sqrt (queryDiscrepancy n) := by
            rw [← Finset.mul_sum]
            ring

end Nightfall.QuantumHybridTelescope


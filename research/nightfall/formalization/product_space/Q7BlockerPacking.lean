import Mathlib

/-! Compact certificate for the 105 previously identified Q7 four-cliques.
A row contains the original 448-bit selected-edge mask, four absent
edges, and eight pairwise-disjoint tight faces. Not a certificate that
these rows enumerate all cliques or any wider radius. -/
namespace Nightfall.Q7BlockerPacking
open Finset

def edge (d v : Nat) : Nat :=
  d * 64 + v % (2^d) + (v / (2^(d+1))) * (2^d)

def face (a b v : Nat) : Finset Nat :=
  {edge a v, edge b v, edge b (v + 2^a), edge a (v + 2^b)}

structure TightFace where
  a : Nat
  b : Nat
  v : Nat
  missing : Nat

def TightFace.blockers (t : TightFace) : Finset Nat :=
  (face t.a t.b t.v).erase t.missing

def TightFace.valid (mask : Nat) (absent : Finset Nat) (t : TightFace) : Bool :=
  decide (t.a < t.b ∧ t.b < 7 ∧ t.v < 128 ∧
    t.v.testBit t.a = false ∧ t.v.testBit t.b = false ∧
    t.missing ∈ face t.a t.b t.v ∧ t.missing ∈ absent ∧
    mask.testBit t.missing = false ∧ t.blockers.card = 3 ∧
    ∀ e ∈ t.blockers, mask.testBit e = true)

structure Row where
  orbit : Nat
  mask : Nat
  absent : Finset Nat
  faces : List TightFace

def Row.groups (r : Row) (i : Fin 8) : Finset Nat :=
  ((r.faces.getD i.val ⟨0,0,0,0⟩)).blockers

def Row.valid (r : Row) : Bool :=
  decide (r.orbit < 180 ∧ r.absent.card = 4 ∧ r.faces.length = 8) &&
  r.faces.all (TightFace.valid r.mask r.absent) &&
  decide (∀ i j : Fin 8, i ≠ j → Disjoint (r.groups i) (r.groups j)) &&
  decide (∀ i : Fin 8, (r.groups i).card = 3)

/-- Eight disjoint obligations force eight different selected elements. -/
theorem disjoint_hitting_lower {W : Type} (g : Fin 8 → Finset W)
    (hd : ∀ i j, i ≠ j → Disjoint (g i) (g j))
    (s : Finset W) (hh : ∀ i, ∃ w ∈ s, w ∈ g i) :
    8 ≤ s.card := by
  classical
  choose w hmem hg using hh
  let f : Fin 8 → ↥s := fun i => ⟨w i, hmem i⟩
  have hf : Function.Injective f := by
    intro i j h
    by_contra hn
    have he : w i = w j := congrArg Subtype.val h
    exact (Finset.disjoint_left.mp (hd i j hn)) (hg i) (he ▸ hg j)
  have h := Fintype.card_le_of_injective f hf
  simpa using h

